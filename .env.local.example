# Copiar a .env.local, sustituir TODOS los marcadores y NO subir .env.local a Git.
# Configuración exclusiva para Windows + Docker Desktop local.
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL
SESSION_SECRET=REEMPLAZAR_CON_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# OAuth web para http://localhost:5173
VITE_GOOGLE_CLIENT_ID=REEMPLAZAR_CON_ID_WEB_GOOGLE.apps.googleusercontent.com
BOOTSTRAP_ADMIN_EMAIL=REEMPLAZAR_CON_CORREO_PROPIO_AUTORIZADO
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Opcional: requisito funcional para tutor IA/RAG; puede quedar vacía para la primera prueba de infraestructura.
GOOGLE_AI_API_KEY=
