# Required secrets (set these in Dokploy; never commit real values)
DB_PASSWORD=replace-with-a-long-random-password
VITE_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=your-admin@virtual.upt.pe

# Public production URLs/origins
VITE_API_URL=https://alda-upt.sytes.net
CORS_ORIGINS=https://alda-upt.sytes.net

# Optional fallback. Provider keys can also be stored from the admin UI.
GOOGLE_AI_API_KEY=
SESSION_TTL_HOURS=8
